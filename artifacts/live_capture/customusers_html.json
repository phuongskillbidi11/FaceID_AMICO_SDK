"<!DOCTYPE html>\n<html>\n<head>\n\t<link rel=\"shortcut icon\" href=\"/images/favicon.ico\" />\n<meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\">\n\n\t<meta content=\"width=device-width, initial-scale=1.0\" name=\"viewport\" />\n\t<meta content=\"width=device-width, initial-scale=1.0\" name=\"viewport\" />\n\t<meta content=\"\" name=\"description\" />\n\t<meta content=\"\" name=\"author\" />\n\n</head>\n<body style=\"background-color: rgb(61, 61, 61);\" class=\"page-header-fixed ui-mobile-viewport ui-overlay-a page\">\n\t<!-- BEGIN CONTAINER -->\n\t<div id=\"MasterConteudo\" style=\"display: none;\" class=\"page-container row-fluid\">\n\t<!-- BEGIN PAGE -->\n\t\t<div class=\"page-content\">\n\t\t\t<!-- BEGIN PAGE CONTAINER-->\n\t\t\t<div class=\"container-fluid\">\n\t\t\t\t<div id=\"BREADCRUMB\" class=\"row-fluid\" cat=\"cad\" ></div>\n\t\t\t\t<!-- END PAGE HEADER-->\n\t\t\t\t<!-- BEGIN PAGE CONTENT-->\n\n\t\t\t\t\t<div class=\"row-fluid\">\n\t\t\t\t\t\t<div id=\"tbl_custom_user\"></div>\n\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class=\"clearfix\"></div>\n\n\t\t\t\t<!-- END PAGE CONTENT-->\n\t\t\t</div>\n\t\t\t<!-- END PAGE CONTAINER-->\n\t\t</div>\n\t\t<div id=\"#tempVideo\" style=\"display:none;\">\n            <video id=\"video\" autoplay style=\"width: 300px; height:225px !important;\"></video>\n            <canvas id=\"canvas\" width=\"300\" height=\"225\" ></canvas>\n        </div>\n\t</div>\n\n\t<div id=\"users_pin\" class=\"control-group\" style=\"display:none; height: 250px;\">\n\t\t<div class=\"tab-title\">PIN</div>\n\t\t<div class=\"row-fluid\" id=\"pin_entry\">\n\t\t\t<div class=\"control-group span6\">\n\t\t\t\t<div class=\"control-group\">\n\t\t\t\t\t<label class=\"control-label\" >PIN\n\t\t\t\t\t</label>\n\t\t\t\t\t<div class=\"controls\">\n\t\t\t\t\t\t<input type=\"text\" id=\"pin_entry_text\" class=\"m-wrap span10\" >\n\t\t\t\t\t\t<span id=\"pin_validation_error_text\" class=\"font-5 error-desc help-inline float-left\"\n\t\t\t\t\t\t\t  style=\"color: #d31245; display: none;\">PIN must be numeric\n\t\t\t\t\t\t</span>\n\t\t\t\t\t\t<!--<i id=\"pin_entry-eye\" class=\"icon-eye-open pointer\" onclick=\"toggleVisibilityPIN()\"></i>-->\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t\t<div class=\"row-fluid\">\n\t\t\t<div class=\"control-group span6\" style=\"margin-top: 24px;\">\n\t\t\t\t<div class=\"control-group\">\n\t\t\t\t\t<label class=\"control-label\" > </label>\n\t\t\t\t\t<div class=\"controls\">\n\t\t\t\t\t\t<button class=\"btn\" onclick=\"enrollOnDevice('pin', false)\">Cadastrar PIN no Equipamento</button>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n\n\t<div id=\"face_template_devices\" class=\"control-group\" style=\"display:none; height: 200px;\">\n\t\t<div class=\"tab-title\">Facial</div>\n\t\t<div class=\"span12\">\n\t\t\t<div class=\"control-group\">\n\t\t\t\t<div class=\"controls\">\n\t\t\t\t\t<button class=\"btn\" onclick=\"enrollFaceOnDevice('face', false)\">Register Face on Equipment</button>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t\t<div class=\"control-group\">\n\t\t\t<div class=\"span4\" id=\"logFacial\" style=\"margin-left: 5px;\" ></div>\n\t\t\t<br/>\n\t\t</div>\n\t\t<div class=\"row-flud\">\n\t\t\t<div class=\"control-group span12\">\n\t\t\t\t<div class=\"control-group\">\n\t\t\t\t\t<div class=\"controls\">\n\t\t\t\t\t\t<button class=\"btn\" onclick=\"toggleAdvancedFaceConfigs()\">Avançado</button>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t\t<div class=\"row-fluid\" id=\"advanced-face-configs\" style=\"display: none;\">\n\t\t\t<div class=\"control-group span12\">\n\t\t\t\t<div class=\"control-group\">\n\t\t\t\t\t<h4>Custom Recognition Threshold</h4>\n\t\t\t\t\t<div class=\"slidecontainer\">\n\t\t\t\t\t\t<input id=\"inputCustomThreshold\" type=\"range\" min=\"0\" max=\"2000\" step=\"10\" class=\"slider span10\">\n\t\t\t\t\t\t<div id=\"curCustomThreshold\"></div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<br />\n\t\t\t\t\t<p><strong>Attention!</strong> Do not change this value if you are not sure of its meaning</p>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n\n\t<div id=\"template_devices\" class=\"control-group\" style=\"display:none;\">\n\t\t<div class=\"tab-title\">Biometrics</div>\n\t\t<div class=\"span12\">\n\t\t\t<div class=\"control-group\">\n\t\t\t\t<label class=\"control-label\" >Number of Fingerprints</label>\n\t\t\t\t<div class=\"controls\">\n\t\t\t\t\t<input type=\"text\" id=\"num_fingerprint\" class=\"m-wrap span3\" disabled>\n\t\t\t\t\t<button class=\"btn\" id=\"delDigitais\">Remove Fingerprints</button>\n\t\t\t\t\t<button class=\"btn\" id=\"addDigitais\" onclick=\"CadastrarDigital()\">Digital Registration</button>\n\t\t\t\t\t<button class=\"btn\" onclick=\"enrollOnDevice('biometry', false)\">Register Digital on the Equipment</button>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class=\"control-group\">\n\t\t\t\t<label class=\"control-label\" >Número de Dedos de Pânico</label>\n\t\t\t\t<div class=\"controls\">\n\t\t\t\t\t<input type=\"text\" id=\"num_duress_fingerprint\" class=\"m-wrap span3\" disabled>\n\t\t\t\t\t<button class=\"btn\" id=\"delDuressDigitais\">Remover Dedos de Pânico</button>\n\t\t\t\t\t<button class=\"btn\" onclick=\"CadastrarDigital(true)\">Cadastrar Dedo de Pânico</button>\n\t\t\t\t\t<button class=\"btn\" onclick=\"enrollOnDevice('biometry', true)\">Cadastrar Dedo de Pânico no Equipamento</button>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\n\t\t<div class=\"control-group\">\n\t\t\t<div class=\"span8\">\n\t\t\t\tPlace your finger to register a new fingerprint:<br/>\n\t\t\t\t<img id=\"imgDedo1\" width=\"100\" style=\"margin-right: 10px;\" />\n\t\t\t\t<img id=\"imgDedo2\" width=\"100\" style=\"margin-right: 10px;\"/>\n\t\t\t\t<img id=\"imgDedo3\" width=\"100\" style=\"margin-right: 10px;\"/>\n\t\t\t</div>\n\t\t\t<div id=\"logDigital\" ></div>\n\t\t\t<br/>\n\t\t</div>\n\t</div>\n\t<div id=\"web_login\" style=\"display:none;\">\n\t\t<div class=\"tab-title\">Web Access</div>\n\n\t\t<div class=\"span6\">\n\t\t\t<div class=\"control-group no-margin\" validate=\"web_login\">\n\t\t\t\t<label class=\"control-label\" disabled=\"\">Login</label>\n\t\t\t\t<div class=\"controls\">\n\t\t\t\t\t<input type=\"text\" id=\"txt_web_login\" class=\"m-wrap span12\" value=\"\">\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t\t<div class=\"span6\">\n\t\t\t<div class=\"control-group no-margin\" validate=\"web_password\">\n\t\t\t\t<label class=\"control-label\" disabled=\"\">Password</label>\n\t\t\t\t<div class=\"controls\">\n\t\t\t\t\t<input type=\"password\" id=\"txt_web_password\" class=\"m-wrap span12\" value=\"\">\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n\t<!-- END CONTAINER -->\n\n\t<!-- BEGIN JAVASCRIPTS(Load javascripts at bottom, this will reduce page load time) -->\n\t<!-- BEGIN PAGE LEVEL SCRIPTS -->\n\t<script src=\"/assets/plugins/jquery-1.11.2.min.js\"></script>\n\t<script src=\"/en_US/js/main.js\"></script>\n\t<script src=\"/en_US/js/pages/customusers.js\"></script>\n\n\t<!-- END JAVASCRIPTS -->\n</body>\n</html>\n"