.agent/logs/

# C++ build artifacts
build/
out/
vcpkg_installed/
CMakeUserPresets.json

# Raw traffic captures — device evidence stays local; only sanitized
# markdown/json summaries under docs/ and artifacts/ are tracked. See
# captures/README.md and docs/security-sanitization-policy.md.
*.pcap
*.pcapng
*.har
*.saz

build-exec/
build-verify/
build-verifier/
build-access-global/
.vs/

# libcurl cookie-jar scratch files from ad-hoc discovery curl calls --
# never meant to be tracked (may hold live session tokens).
cookies*.txt

# Full headless-browser user-data profiles (real Cookies SQLite DBs,
# cache, history) generated by a one-off offline-render experiment --
# scratch automation state, never meant to be tracked.
artifacts/access-global-offline/
